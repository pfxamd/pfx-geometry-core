{
  "name": "@pfxamd/geometry-core",
  "version": "0.12.3",
  "description": "A deterministic, renderer-independent geometry and perspective foundation.",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": "./adapters/three/index.mjs"
  },
  "files": [
    "dist",
    "adapters",
    "README.md",
    "LICENSE",
    "version.json",
    "version-badge.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "benchmark": "npm run build && node benchmarks/intersections.mjs",
    "benchmark:irregular": "npm run build && node benchmarks/irregular.mjs",
    "release:version": "node .pfx/release.mjs --sync"
  },
  "peerDependencies": {
    "three": "^0.186.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "three": "0.186.1",
    "playwright-core": "1.56.1",
    "@pfxamd/release-core": "https://github.com/pfxamd/pfx-release-core/releases/download/v0.1.0-alpha.1/pfxamd-release-core-0.1.0-alpha.1.tgz"
  },
  "license": "MIT",
  "dependencies": {
    "robust-predicates": "3.0.3"
  }
}
